# Copy to .env for local use. Supply real values privately; do not commit .env.
DB_URL=jdbc:postgresql://localhost:5432/quanngon
DB_USERNAME=postgres
DB_PASSWORD=

# Generate two independent random secrets, each at least 64 UTF-8 bytes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail address and Google App Password; keep SMTP on port 587.
MAIL_USERNAME=
MAIL_PASSWORD=

# Use rediss:// when your provider requires TLS. URL credentials must be URL-encoded.
REDIS_URL=redis://localhost:6379
STATISTICS_TIME_ZONE=Asia/Ho_Chi_Minh

# Local values. On Azure, use the exact Vercel origin and the HTTPS values in README.
APP_ALLOWED_ORIGINS=http://localhost:5173
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax
APP_REQUIRE_HTTPS=false
FORWARD_HEADERS_STRATEGY=none

# Logging: console logs include requestId; use DEBUG temporarily when investigating an issue.
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
# Use WARN to omit successful/4xx request summaries while keeping 5xx summaries.
LOG_LEVEL_HTTP=INFO
